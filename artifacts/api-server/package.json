{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:roulette": "NODE_ENV=test BOT_TOKEN=test MONGODB_URI=mongodb://test.invalid vitest run src/roulette --passWithNoTests"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bufferutil": "^4.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.4",
    "multer": "^2.4.0",
    "nanoid": "^3.3.18",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.67.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "telegram": "^2.26.22",
    "utf-8-validate": "^6.0.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/node-telegram-bot-api": "^0.64.15",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^5.0.1"
  }
}
